# The gateway's whole configuration.
#
# Read with `deploy/compose.gateway.yaml`. Everything that varies between
# deployments is an environment variable, so this file is the same on every host
# and there is nothing in it to edit by hand at 11pm.

{
	# Where the certificate authority sends expiry warnings. Empty is valid and
	# issuance still works — the certificate simply renews with nobody told if
	# it stops being able to.
	email {$CONSTRUX_TLS_EMAIL}

	# Caddy's own log. `warn` because an access log at info level on a busy day
	# is the thing that fills the disk the journal is also on.
	log {
		level warn
	}
}

# The www host, which exists so that a link to it works.
#
# ## What happened
#
# Caddy obtains a certificate for the hostnames it has a site block for, and
# there was one block for one name. Anything arriving at `www.` — which DNS
# happily pointed at the same address — reached a server with no certificate for
# the name being asked for, so the handshake failed before a single byte of HTTP
# was exchanged. The browser reports that as `ERR_SSL_PROTOCOL_ERROR`, which
# reads like a broken server rather than a name nobody configured.
#
# It surfaced through invitations. `PUBLIC_BASE_URL` was set to the www form, so
# every person invited to the platform was emailed "sign in at
# https://www.…/app" — a link to the one hostname the gateway could not serve.
# The people who could least afford a dead end, on their first contact with the
# product, were the only ones who ever saw it.
#
# ## Why a redirect rather than a second copy of the site
#
# One canonical origin. Two hostnames both serving the application means two
# origins for cookies, two for the CSP, two in a bookmark and two in a support
# call — and a session started on one is not a session on the other. The apex is
# canonical, this sends everything to it with the path intact, and
# `deploy/env-check.sh` refuses a `CONSTRUX_DOMAIN` that already begins with
# `www.` so this block can never become `www.www.`.
www.{$CONSTRUX_DOMAIN} {
	redir https://{$CONSTRUX_DOMAIN}{uri} permanent
}

{$CONSTRUX_DOMAIN} {
	# One upstream, by container name. Not an IP: a container's address changes
	# on every recreate, and a deploy that silently 502s afterwards is the
	# failure this avoids.
	reverse_proxy construx:8080 {
		# The platform reads these to resolve the real client address for rate
		# limiting — see `GATEWAY_TRUSTED_PROXIES` in `.env.example`. Without
		# them every request appears to come from the gateway, and one abusive
		# client would rate-limit everybody.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}

		# A journal replay on a large record takes longer than a default
		# gateway will wait. The platform's readiness probe is what decides
		# when traffic may arrive; this is what stops the gateway giving up on
		# a request that is simply doing work.
		transport http {
			response_header_timeout 120s
		}
	}

	# Compression on the way out. The console is plain ES modules and the API
	# answers JSON; both compress by roughly a factor of four, and on a site
	# visited from a phone on site that is the difference people feel.
	encode zstd gzip

	header {
		# HSTS. Only meaningful once the certificate is real, which it is by
		# the time this file is serving anything.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The platform sets its own CSP and frame policy per response; these
		# are the ones a gateway is the right place for.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Caddy's version, off. It tells an attacker what to look up.
		-Server
	}

	# Access log as structured JSON on stdout, so `docker logs` and the
	# collector see the same records rather than two formats of the same thing.
	log {
		output stdout
		format json
	}
}
