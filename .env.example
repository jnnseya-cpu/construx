# ---------------------------------------------------------------------------
# CONSTRUX.AI — gateway configuration
# Every flag below is read at boot by src/config.ts. Defaults are safe.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=development

# --- Durability -------------------------------------------------------------
# Where the append-only ledger is written. EMPTY MEANS IN MEMORY ONLY: the
# entire record is lost on restart. Fine for a test run, total data loss
# anywhere else, and the service says so loudly at boot in production.
#
# Point it at a mounted volume, not at the container filesystem. The ACU
# wallet's entries are written beside it with an `.acu` suffix, because AI
# spend is a separate double-entry ledger by design.
LEDGER_JOURNAL_PATH=
# Flush each event to the platter before acknowledging it. Only ever disable
# this in a throwaway environment — with it off, the process can confirm a
# commit that has not reached the disk.
LEDGER_JOURNAL_FSYNC=true

# --- Authentication & session control ---------------------------------------
GATEWAY_REQUIRE_AUTH=true
GATEWAY_AUTH_EXPOSE_MFA=true
GATEWAY_AUTH_ACCESS_TTL_MINUTES=15
GATEWAY_AUTH_REFRESH_TTL_DAYS=7
# HMAC signing secret for platform-issued tokens. Replace in every environment.
GATEWAY_JWT_SECRET=change-me-in-every-environment

# --- Authorization ----------------------------------------------------------
GATEWAY_RBAC_ENABLED=true
GATEWAY_ABAC_ENABLED=true
GATEWAY_SCOPES_ENABLED=true

# --- Rate limiting ----------------------------------------------------------
GATEWAY_RATE_LIMIT_MAX=1000
GATEWAY_RATE_LIMIT_BURST=200
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
# Where the rate-limit buckets live. Empty means in-process, which is correct
# for one instance and silently wrong for more than one: N replicas are N
# separate buckets, so the limits above are enforced N times over. Set this the
# moment the deployment scales past a single container.
# GATEWAY_RATE_LIMIT_REDIS_URL=redis://cache:6379

# --- Request validation -----------------------------------------------------
GATEWAY_REQUIRE_VALIDATION=true

# --- Commercial rules -------------------------------------------------------
# Provider cost is charged at this multiple. 4 means the company keeps £3 of
# every £4 it takes — 300% profit on what it paid the provider.
ACU_MARKUP_MULTIPLIER=4
# The company's required profit on every AI transaction, as a percentage of
# what the provider charged. 100 means the platform never keeps less than it
# paid out. The multiplier floor is derived from this (1 + pct/100), so the
# rule and the arithmetic cannot drift apart.
ACU_MINIMUM_PROFIT_PERCENT=100
# One ACU is one minor unit, so £1 buys 100 ACUs.
ACU_UNIT_MINOR=1
ACU_PER_MAJOR_UNIT=100
# The share of every subscription payment credited to the tenant's AI wallet.
ACU_SUBSCRIPTION_ALLOCATION_PERCENT=20
# One-off grant so AI can be tried without a payment method — and stops when
# it runs out.
FREE_TRIAL_GRANT_MINOR=500

# What one 100GB block of extra storage costs per month. Recurring, not one-off:
# the record is append-only, so capacity sold is capacity held for as long as
# the contract can be sued on. A single payment for a permanent obligation is a
# liability that compounds with every block sold.
STORAGE_BLOCK_PRICE_MINOR=1500

# The largest single payment the platform will credit, in minor units.
# Not a limit on what a customer may spend: a larger settlement is recorded as
# several receipts, each with its own reference. It is a guard against a typo
# with three extra zeros and against a malformed webhook, both of which put a
# number into an append-only ledger that nobody can quietly take back out.
MAXIMUM_CREDIT_MINOR=10000000

# Days between an erasure request and the erasure itself. The delay is a safety
# feature: erasure is irreversible, and the window is what lets the real owner
# stop a request made with a stolen session.
ERASURE_GRACE_DAYS=30

# --- AI control plane -------------------------------------------------------
# local = deterministic mock brains (no spend). staging = real providers, capped.
# production = real providers, full ACU enforcement.
AI_MODE=local
AI_REASONING_PROVIDER=OPENAI
AI_PERCEPTION_PROVIDER=GEMINI
# Provider credentials — only read when AI_MODE != local.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Public origin ----------------------------------------------------------
# Absolute origin used in email links. Email cannot resolve a relative path,
# and unsubscribe links carry a signed token, so this must be https in
# production.
PUBLIC_BASE_URL=http://localhost:8080

# --- Marketing measurement --------------------------------------------------
# Meta Pixel and Google tag, on the PUBLIC SITE ONLY. Both empty by default,
# and everything downstream is inert while they are: no third-party script is
# served, no consent banner appears, and the content-security-policy keeps the
# shape it has without them. A development machine should never be reporting
# page views into somebody's ad account.
#
# The signed-in console is deliberately out of scope and stays that way. Its
# paths carry tenant, project and entity identifiers, so a page view sent from
# /app would tell two advertising networks which projects a customer runs and
# how fast they are moving. There is nothing to measure there either — the
# conversion was won at the door.
#
# Nothing loads before consent. Both vendors set cookies that are not necessary
# to provide the service, which under PECR means asking first rather than
# reporting while the banner is still on screen.
ANALYTICS_META_PIXEL_ID=
ANALYTICS_GOOGLE_TAG_ID=

# --- Weekly newsletter ------------------------------------------------------
# Off unless switched on. A marketing sender that armed itself at boot would
# send from a laptop, a CI run and a restored backup.
NEWSLETTER_ENABLED=false
# UTC day-of-week (1 = Monday) and hour the weekly issue goes out.
NEWSLETTER_SEND_DAY_UTC=2
NEWSLETTER_SEND_HOUR_UTC=9
NEWSLETTER_FROM_NAME=CONSTRUX.AI
NEWSLETTER_FROM_ADDRESS=hello@construx.ai
NEWSLETTER_REPLY_TO=
# Whether a registered user is in the audience before expressing a preference.
# A withdrawal is permanent either way until the person re-subscribes.
NEWSLETTER_DEFAULT_SUBSCRIBED=true
# Roles never marketed to regardless of consent. A regulator holds an oversight
# identity, not a customer relationship.
NEWSLETTER_EXCLUDED_ROLES=REGULATOR
NEWSLETTER_THROTTLE_MS=120

# --- SMTP submission --------------------------------------------------------
# With no host set, issues are composed and recorded against each recipient but
# nothing is transmitted, and the operator screen says so.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on 465; false starts plaintext and issues STARTTLS.
SMTP_SECURE=false
# Refuse to continue in cleartext if STARTTLS is unavailable.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=15000

# --- Evidence object store ---------------------------------------------------
# Where uploaded evidence is held. Unset means hashes are recorded and files are
# not, so the chain depends on whoever still has the original.
EVIDENCE_STORE_PATH=
EVIDENCE_MAX_BYTES=52428800
EVIDENCE_LINK_TTL_SECONDS=300

# Largest file sent to a perception provider in one request. Below the evidence
# store's ceiling on purpose — no provider accepts a 50MB drawing set inline.
AI_PERCEPTION_MAX_BYTES=20971520

# --- Signing --------------------------------------------------------------
# Ed25519 private key (PKCS8 PEM) the platform witnesses signatures with.
# Generate with: openssl genpkey -algorithm ed25519 -out signing.pem
# Unset means every signing request is refused — an ephemeral key would
# invalidate every signature already made, silently, on the next restart.
# Literal \n is expanded, so a one-line value works.
SIGNING_PRIVATE_KEY_PEM=
