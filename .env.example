# ---------------------------------------------------------------------------
# CONSTRUX.AI — gateway configuration
# Every flag below is read at boot by src/config.ts. Defaults are safe.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=development

# --- Durability -------------------------------------------------------------
# The commit the running container was built from, reported on `/readyz`.
#
# DO NOT SET THIS. `deploy/autodeploy.sh` fills it in from `git rev-parse HEAD`
# at the moment it deploys; a value pinned here would be wrong on every deploy
# after the one it was written for, which is worse than the honest `unknown`
# an unset one produces.
#
# It is documented here rather than left invisible because it answers the
# question "is the live site running the latest?" — compare it against
# `git rev-parse origin/<branch>`. See docs/RUNBOOK.md.
BUILD_COMMIT=

# Where the append-only ledger is written. EMPTY MEANS IN MEMORY ONLY: the
# entire record is lost on restart. Fine for a test run, total data loss
# anywhere else, and the service says so loudly at boot in production.
#
# Point it at a mounted volume, not at the container filesystem. The ACU
# wallet's entries are written beside it with an `.acu` suffix, because AI
# spend is a separate double-entry ledger by design.
LEDGER_JOURNAL_PATH=
# Flush each event to the platter before acknowledging it. Only ever disable
# this in a throwaway environment — with it off, the process can confirm a
# commit that has not reached the disk.
LEDGER_JOURNAL_FSYNC=true
# Exactly one process may extend the chain. The writer refreshes a claim beside
# the journal (`.writer`) at this interval, and a second process starting on the
# same volume refuses rather than interleaving its appends — two writers produce
# a chain where every event after the first interleave hashes against the wrong
# predecessor, and nothing says so until a replay is run in a dispute. A holder
# that dies without releasing is taken over after three missed heartbeats.
LEDGER_WRITER_HEARTBEAT_SECONDS=10

# --- The platform operator ---------------------------------------------------
# Ensures this address holds a PLATFORM_ADMIN, checked at every boot.
#
# Without it a production deployment cannot be administered at all: every admin
# route demands PLATFORM_ADMIN, the only thing that created one was the
# demonstration seed, and the demonstration seed is off in production. The
# platform comes up, serves the site, and can never be signed into.
#
# Not a route, deliberately. A public endpoint that mints a PLATFORM_ADMIN is
# the worst thing that could be put on the internet, whatever guard is in front
# of it — setting this requires the server itself.
#
# Sign-in is an emailed one-time code, so this address IS the credential. Use a
# mailbox you can read, and one NOTIFICATIONS_FROM_ADDRESS can actually send to.
#
# Keyed on the address, not on a count: change it and the next boot ensures the
# new address, leaving the old operator in place. Guarding on "no operators at
# all" would mean a deployment that picked the wrong address once could never
# correct it without being able to sign in — which is the lockout this setting
# exists to prevent. Remove an old operator through the console, not here.
PLATFORM_OPERATOR_EMAIL=
PLATFORM_OPERATOR_NAME=Platform operator

# --- Demonstration tenancy ---------------------------------------------------
#
# ON by default. The platform seeds the Meridian lifecycle at boot
# — one real project carried from concept to operations — as a genuine tenancy
# with twelve identities that sign in through the ordinary login and MFA path.
# It is what a production deployment shows a prospective customer instead of an
# empty world.
#
# READ THIS BEFORE SETTING IT ON A DEPLOYMENT CARRYING REAL CUSTOMERS.
#
# 1. The twelve seeded accounts become PUBLIC. Their addresses are
#    @meridian.example and belong to nobody, so their one-time code is returned
#    in the login response rather than emailed — anyone may sign in as any of
#    them. That is the point of a demonstration. It applies to those twelve
#    accounts and to nothing else: a real customer's account is unaffected, and
#    no operator is reachable this way under any setting.
# 2. Anyone signed in as one of them can WRITE to that tenancy. It is a sandbox
#    in a real ledger, isolated from every other tenancy by the same tenant
#    isolation that separates two customers.
# 3. Seeding it costs NOTHING. The seed runs against the deterministic local
#    engines whatever AI_MODE says, so building the fixture is free and gives
#    the same result on every deployment of the same commit. What a VISITOR
#    does on it afterwards runs against the configured providers and spends
#    from the demonstration wallet, capped by DEMO_ACU_CREDIT_MINOR below. When
#    that empties the platform refuses to call a provider, which is normal,
#    tested behaviour and reads correctly on screen.
# 4. It does NOT reopen POST /v1/console/session, which hands an anonymous
#    caller a token with no challenge at all. That stays refused in production
#    whatever this is set to.
DEMO_TENANCY_ENABLED=true
# Opening credit for the demonstration wallet, in minor units (500000 = £5,000).
# The seed consumes some of this producing the lifecycle it shows.
DEMO_ACU_CREDIT_MINOR=500000

# --- Authentication & session control ---------------------------------------
GATEWAY_REQUIRE_AUTH=true
GATEWAY_AUTH_EXPOSE_MFA=true
GATEWAY_AUTH_ACCESS_TTL_MINUTES=15
GATEWAY_AUTH_REFRESH_TTL_DAYS=7
# HMAC signing secret for platform-issued tokens. Replace in every environment.
GATEWAY_JWT_SECRET=change-me-in-every-environment

# --- Authorization ----------------------------------------------------------
GATEWAY_RBAC_ENABLED=true
GATEWAY_ABAC_ENABLED=true
GATEWAY_SCOPES_ENABLED=true

# --- Rate limiting ----------------------------------------------------------
GATEWAY_RATE_LIMIT_MAX=1000
GATEWAY_RATE_LIMIT_BURST=200
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
# Where the rate-limit buckets live. Empty means in-process, which is correct
# for one instance and silently wrong for more than one: N replicas are N
# separate buckets, so the limits above are enforced N times over. Set this the
# moment the deployment scales past a single container.
# GATEWAY_RATE_LIMIT_REDIS_URL=redis://cache:6379

# --- Request validation -----------------------------------------------------
GATEWAY_REQUIRE_VALIDATION=true

# --- Commercial rules -------------------------------------------------------
# Provider cost is charged at this multiple. 5 means the company keeps £4 of
# every £5 it takes — 400% profit on what it paid the provider, which is the
# business rule as stated: every £1 spent with a provider produces £5.
ACU_MARKUP_MULTIPLIER=5
# The company's required profit on every AI transaction, as a percentage of
# what the provider charged. 100 means the platform never keeps less than it
# paid out. The multiplier floor is derived from this (1 + pct/100), so the
# rule and the arithmetic cannot drift apart.
#
# Deliberately BELOW the markup. This is a loss guard, not the price. An
# execution that overruns its estimate is capped at the amount reserved and
# disclosed, unless honouring that cap would sell below this floor. Raising it
# to meet the markup makes floor == charge on every overrun, so the cap can
# never bite and a customer shown £5 can be billed £7.50 with no ceiling.
ACU_MINIMUM_PROFIT_PERCENT=100
# One ACU is one minor unit, so £1 buys 100 ACUs.
ACU_UNIT_MINOR=1
ACU_PER_MAJOR_UNIT=100
# The share of every subscription payment credited to the tenant's AI wallet.
ACU_SUBSCRIPTION_ALLOCATION_PERCENT=20
# One-off grant so AI can be tried without a payment method — and stops when
# it runs out.
FREE_TRIAL_GRANT_MINOR=500

# What one 100GB block of extra storage costs per month. Recurring, not one-off:
# the record is append-only, so capacity sold is capacity held for as long as
# the contract can be sued on. A single payment for a permanent obligation is a
# liability that compounds with every block sold.
STORAGE_BLOCK_PRICE_MINOR=1500

# The largest single payment the platform will credit, in minor units.
# Not a limit on what a customer may spend: a larger settlement is recorded as
# several receipts, each with its own reference. It is a guard against a typo
# with three extra zeros and against a malformed webhook, both of which put a
# number into an append-only ledger that nobody can quietly take back out.
MAXIMUM_CREDIT_MINOR=10000000

# Free trial grants allowed per organisation. An organisation is the email
# domain for a company address, and the mailbox itself for a free-mail one —
# plus-suffixes and Gmail dots normalised away, because every one of those is
# the same inbox and each grant is real provider spend.
TRIALS_PER_ORGANISATION=1

# Days between an erasure request and the erasure itself. The delay is a safety
# feature: erasure is irreversible, and the window is what lets the real owner
# stop a request made with a stolen session.
ERASURE_GRACE_DAYS=30

# --- AI control plane -------------------------------------------------------
# local = deterministic mock brains (no spend). staging = real providers, capped.
# production = real providers, full ACU enforcement.
AI_MODE=local
# Which vendor serves each capability. OPENAI | GEMINI | ANTHROPIC.
#
# Two brains, not two vendors: REASONING is the analytical engine set and
# PERCEPTION reads drawings, photographs and audio. Either can be pointed at
# any of the three — an unrecognised name falls back to the default rather than
# resolving to whichever vendor a conditional happened to reach.
AI_REASONING_PROVIDER=OPENAI
AI_PERCEPTION_PROVIDER=GEMINI
# Provider credentials — only read when AI_MODE != local.
#
# Any provider holding a key joins the failover chain, whether or not it is a
# primary. With only two vendors the fallback is vendor-diverse by accident —
# it works because the two capabilities sit on different companies, and stops
# working the moment both are pointed at the same one. A third key is what
# makes it deliberate.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Public origin ----------------------------------------------------------
# Absolute origin used in email links. Email cannot resolve a relative path,
# and unsubscribe links carry a signed token, so this must be https in
# production.
PUBLIC_BASE_URL=http://localhost:8080

# --- Marketing measurement --------------------------------------------------
# Meta Pixel and Google tag, on the PUBLIC SITE ONLY. Both empty by default,
# and everything downstream is inert while they are: no third-party script is
# served, no consent banner appears, and the content-security-policy keeps the
# shape it has without them. A development machine should never be reporting
# page views into somebody's ad account.
#
# The signed-in console is deliberately out of scope and stays that way. Its
# paths carry tenant, project and entity identifiers, so a page view sent from
# /app would tell two advertising networks which projects a customer runs and
# how fast they are moving. There is nothing to measure there either — the
# conversion was won at the door.
#
# Nothing loads before consent. Both vendors set cookies that are not necessary
# to provide the service, which under PECR means asking first rather than
# reporting while the banner is still on screen.
ANALYTICS_META_PIXEL_ID=
ANALYTICS_GOOGLE_TAG_ID=

# --- The landing page's own pictures ----------------------------------------
# Five slots on the landing page. The operator fills them from the console, and
# the picture is live immediately — no restart.
#
# Unset means frontend/media/ inside the checkout, which is where they used to
# live and is fine on a laptop. On a deployed container that directory is inside
# the image, so an uploaded picture is lost on the next redeploy. Point this at
# the same volume the ledger journal uses and it survives one.
SITE_MEDIA_PATH=
# Per-picture ceiling. The largest slot is a 2400px plate, which compresses to
# somewhere between 600KB and 1.5MB; the limit exists so the marketing page
# cannot fill the volume the ledger is writing to.
SITE_MEDIA_MAX_BYTES=8388608

# --- Notification outbox ----------------------------------------------------
# Every notice is written to the ledger before it is transmitted, so a process
# that dies mid-send leaves a notice the platform still owes rather than
# nothing at all. These govern what happens to one that will not go.
#
# Attempts before the platform stops trying. The failures worth retrying are
# transient; the ones that are not do not become deliverable on the sixth try.
NOTIFICATIONS_MAX_ATTEMPTS=5
# The first retry waits this long, doubling each attempt.
NOTIFICATIONS_RETRY_BACKOFF_SECONDS=60
# How often the queue drains on its own. The queue is drained inline on every
# send, so this timer exists for one case: notices queued by a process that
# died before delivering them.
NOTIFICATIONS_DRAIN_INTERVAL_SECONDS=60

# --- Weekly newsletter ------------------------------------------------------
# Off unless switched on. A marketing sender that armed itself at boot would
# send from a laptop, a CI run and a restored backup.
NEWSLETTER_ENABLED=false
# UTC day-of-week (1 = Monday) and hour the weekly issue goes out.
NEWSLETTER_SEND_DAY_UTC=2
NEWSLETTER_SEND_HOUR_UTC=9
# Marketing only. Never used for a login code or a verification link.
NEWSLETTER_FROM_NAME=CONSTRUX.AI
NEWSLETTER_FROM_ADDRESS=hello@construx.ai
NEWSLETTER_REPLY_TO=
# Whether a registered user is in the audience before expressing a preference.
# A withdrawal is permanent either way until the person re-subscribes.
NEWSLETTER_DEFAULT_SUBSCRIBED=true
# Roles never marketed to regardless of consent. A regulator holds an oversight
# identity, not a customer relationship.
NEWSLETTER_EXCLUDED_ROLES=REGULATOR
NEWSLETTER_THROTTLE_MS=120

# --- Account mail -----------------------------------------------------------
# Who login codes, verification links and account notices come from.
#
# Separate from the newsletter sender deliberately. A login code is mandatory
# and carries no unsubscribe; a marketing issue is consented to and must. Using
# one address for both either puts marketing in the mailbox staff read, or
# sends the message people most want to reply to from an address that cannot
# receive a reply.
#
# Most relays — Hostinger included — require this to be the same mailbox
# SMTP_USER authenticates as. If mail is silently not arriving, that mismatch
# is the first thing to check.
#
# Falls back to NEWSLETTER_FROM_ADDRESS when unset.
NOTIFICATIONS_FROM_NAME=CONSTRUX.AI
NOTIFICATIONS_FROM_ADDRESS=

# --- SMTP submission --------------------------------------------------------
# With no host set, issues are composed and recorded against each recipient but
# nothing is transmitted, and the operator screen says so.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on 465; false starts plaintext and issues STARTTLS.
SMTP_SECURE=false
# Refuse to continue in cleartext if STARTTLS is unavailable.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=15000

# --- Evidence object store ---------------------------------------------------
# Where uploaded evidence is held. Unset means hashes are recorded and files are
# not, so the chain depends on whoever still has the original.
# --- The platform watching itself --------------------------------------------
# Counters have existed since the gateway was built and nothing read them. These
# thresholds are what a handful of rules judge them against, every interval,
# with alerts sent to the operator through the notification outbox — so an alert
# survives a process death exactly as a customer notification does.
#
# Rates over the interval, never totals since boot: a total is useless after a
# day. The minimum sample is the floor under every rate, because "100% of
# requests failed" over one request is the alert that gets a system muted.
OPS_WATCH_ENABLED=true
OPS_WATCH_INTERVAL_SECONDS=60
OPS_WATCH_RENOTIFY_MINUTES=30
OPS_WATCH_MINIMUM_SAMPLE=20
OPS_WATCH_SERVER_ERROR_PERCENT=5
OPS_WATCH_AUTH_FAILURE_PERCENT=20
OPS_WATCH_RATE_LIMITED_THRESHOLD=50

# --- Signature scanning ------------------------------------------------------
# The platform holds no virus signatures and never will — zero runtime
# dependencies is settled. What it can do is talk to a daemon that does, over
# clamd's INSTREAM protocol. Unset means nothing scans, and every ingestion
# record and every read says so rather than implying a check nobody made.
#
# Configured and unreachable is a refusal, not a shrug: the ingestion fails and
# the file stays in the not-yet-read queue, because a file recorded as ingested
# reads as a file that was checked.
# --- Postgres ---------------------------------------------------------------
#
# Unset means the ledger lives in the append-only journal on a volume. That is
# durable, verified on restore, and single-instance by enforcement: a second
# writer on the same volume refuses to start rather than interleaving appends.
#
# Setting POSTGRES_HOST moves the ledger into Postgres, which is what makes the
# application tier stateless and therefore horizontally scalable. Both halves are
# verified against a live Postgres 16 — the schema by deploy/postgres/verify.sh
# and the client by deploy/postgres/client-check.sh.
#
# POSTGRES_TLS=require refuses a server that will not start TLS, before any
# credential crosses the wire. It is the only defensible setting for a database
# reached over anything but loopback; `prefer` continues without it and
# `disable` never asks.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=construx_app
POSTGRES_PASSWORD=
POSTGRES_DATABASE=construx
POSTGRES_TLS=require
POSTGRES_TLS_VERIFY=true
# Where schema.sql puts the tables. Pinned at startup rather than SET later, so
# it holds for the first statement and no later statement can change it.
POSTGRES_SEARCH_PATH=goldenthread, public
POSTGRES_POOL_SIZE=8
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# --- Object storage ----------------------------------------------------------
#
# Unset means evidence lives on the volume at EVIDENCE_STORE_PATH. That is
# correct for a single instance and is exactly why the application tier cannot be
# replicated: two containers on separate volumes each hold half the evidence, and
# a request routed to the wrong one reports a file the platform certainly holds
# as one it does not.
#
# Setting these moves evidence to an S3-compatible store — AWS, R2, MinIO,
# Backblaze, Ceph — which any number of containers can reach. Signed with SigV4
# by hand, because zero runtime dependencies is settled; verified against AWS's
# own published signature vector and against a fake store speaking real S3.
#
# When set, the object store is the ONLY store, not a cache in front of the
# volume: two places a file might be is two answers to "is it held".
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
# Most self-hosted stores need path style; AWS prefers virtual-hosted.
OBJECT_STORE_PATH_STYLE=true
OBJECT_STORE_TIMEOUT_MS=30000

# --- Self-managing platform --------------------------------------------------
#
# Chain assurance verifies a rotating slice of projects in the background and
# raises a critical alert on the first divergence. Without it, the first
# realistic moment a divergence is discovered is during a dispute, by the person
# least able to do anything about it. It detects and never repairs: a process
# that "fixed" a chain would be indistinguishable from the tampering it exists
# to catch.
#
# A slice per pass, because verifying every project every pass grows without
# bound. The admin position reports how many passes a full circuit takes, so
# "verified continuously" is a measurable claim rather than a reassuring one.
CHAIN_ASSURANCE_ENABLED=true
CHAIN_ASSURANCE_INTERVAL_SECONDS=900
CHAIN_ASSURANCE_PROJECTS_PER_PASS=5

# Auto-repair is bounded to restart and reroute: a timer that stopped and a
# queue that is owed and idle, both silent failures whose first symptom is a
# customer noticing. It never changes code, configuration, permissions or a
# chain, and it never deploys — an agent that can change the code holding the
# evidence can change the evidence. What it refuses is published on
# /v1/admin/repair rather than left to be assumed.
AUTO_REPAIR_ENABLED=true
AUTO_REPAIR_INTERVAL_SECONDS=120

# --- Observability egress ----------------------------------------------------
#
# Unset means the counters, the latency histogram and the security stream still
# exist and still answer the admin screens — they simply die with the container.
# Setting an endpoint ships them to a collector, which is what makes
# post-incident analysis possible without having kept the container.
#
# OTLP over HTTP with the JSON encoding, so no protobuf runtime is needed.
# OTEL_EXPORTER_OTLP_HEADERS is where a collector's auth token goes; it is parsed
# and never logged, and the health endpoint reports the endpoint but not these.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=construx
OTEL_EXPORT_INTERVAL_SECONDS=30
# Bounded deliberately: a collector down for a week fills this and then drops,
# counted and visible, rather than growing until the process is killed for memory.
OTEL_QUEUE_SIZE=2048
OTEL_BATCH_SIZE=256
OTEL_EXPORT_TIMEOUT_MS=10000

ANTIVIRUS_CLAMD_HOST=
ANTIVIRUS_CLAMD_PORT=3310
ANTIVIRUS_TIMEOUT_MS=10000

EVIDENCE_STORE_PATH=
EVIDENCE_MAX_BYTES=52428800
EVIDENCE_LINK_TTL_SECONDS=300

# Largest file sent to a perception provider in one request. Below the evidence
# store's ceiling on purpose — no provider accepts a 50MB drawing set inline.
AI_PERCEPTION_MAX_BYTES=20971520

# Which vendor may be sent what.
#
# DataSensitivity already decides who inside a customer may READ a record. This
# decides who the platform may HAND IT TO — a different question, and the one
# that was missing: a legally privileged clause a safety manager is barred from
# opening could still be posted to any configured AI vendor.
#
# Levels, least to most sensitive:
#   PUBLIC  INTERNAL  SAFETY_L2  COMMERCIAL_L3  LEGAL_L4
#
# Set a vendor's ceiling only once the contract with that vendor actually permits
# it — a data processing agreement, a retention promise, a processing region.
# Unset, every vendor is capped at AI_DEFAULT_CLEARANCE, which means contracts,
# claims and safety records are refused rather than routed. That is the safe
# state, not a broken one.
#
#   AI_PROVIDER_CLEARANCE=ANTHROPIC:LEGAL_L4,OPENAI:INTERNAL,GEMINI:PUBLIC
AI_PROVIDER_CLEARANCE=
AI_DEFAULT_CLEARANCE=INTERNAL

# Below this confidence, a machine-read result is held for review rather than
# taken as read. A policy about how much this deployment trusts extraction, not
# a fact about any one register.
AI_CONFIDENCE_THRESHOLD=0.75
# Per-task overrides, as `title_block_extraction:0.9,clause_extraction:0.85`.
# Reading a title block off a drawing and reading an obligation out of a
# contract are not the same risk, and one number for both is either too loose
# for the clause or too tight for the drawing.
AI_CONFIDENCE_THRESHOLDS=

# --- Signing --------------------------------------------------------------
# Ed25519 private key (PKCS8 PEM) the platform witnesses signatures with.
# Generate with: openssl genpkey -algorithm ed25519 -out signing.pem
# Unset means every signing request is refused — an ephemeral key would
# invalidate every signature already made, silently, on the next restart.
# Literal \n is expanded, so a one-line value works.
SIGNING_PRIVATE_KEY_PEM=

# --- Stripe ------------------------------------------------------------------
# Card payment for prepaid AI credit. Unset means the checkout route answers 503
# and top-up requests are recorded for the operator to settle by bank transfer —
# the platform works without Stripe, it just cannot take a card.
#
# The secret key. Server-side only; it is never sent to a browser.
STRIPE_SECRET_KEY=
# The webhook signing secret, from the Stripe dashboard's endpoint page.
#
# This is the only thing standing between a public URL and the ACU wallet. The
# webhook has to be unauthenticated — Stripe holds no credential of ours — so
# the signature is the credential. Unset, the route refuses every request, which
# is the correct failure: an unverified webhook that credits money is worse than
# no webhook at all.
STRIPE_WEBHOOK_SECRET=
# Pinned, so a version rolled out on Stripe's side cannot reshape what we parse.
STRIPE_API_VERSION=2024-06-20
# Where Stripe returns the customer. Defaults to the billing page under
# PUBLIC_BASE_URL, which is right unless the console is served elsewhere.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- KODA (mobile money) -----------------------------------------------------
# The second payment rail, beside the card. Unset means the mobile-money
# checkout answers 503 and top-up requests are still recorded for the operator
# to settle by hand — the same failure mode as Stripe, for the same reason.
#
# Server-side only. Use the sk_ secret key, never a pk_ publishable one: this
# platform creates intents from the backend, so a browser-safe key would be
# both unnecessary and weaker.
KODA_SECRET_KEY=
# Signs x-koda-signature — HMAC-SHA256 of the raw body, hex.
#
# The only credential on a public route that credits wallets. KODA signs no
# timestamp, so unlike Stripe there is no tolerance window and a captured
# webhook stays valid for ever; replay is stopped by the payment reference
# alone. Unset, the webhook refuses everything, which is the correct
# unconfigured state.
KODA_WEBHOOK_SECRET=
KODA_BASE_URL=https://kodajnn.com/v1
# Mobile-money operators offered at checkout, in KODA's own codes.
KODA_OPERATORS=orange_cd,mpesa_cd
# Where KODA returns the customer. Defaults to the billing page.
KODA_SUCCESS_URL=
# US dollars per pound.
#
# The platform prices in GBP and this rail settles in USD, so one number
# bridges them. Deliberately an operator-set constant rather than a live feed:
# a rate fetched at settlement makes a credit impossible to reproduce from the
# ledger later, and adds a third-party dependency to the one path where failure
# means taking money and crediting nothing. The rate in force is copied onto
# the intent when the customer is quoted and onto the receipt when it settles,
# so changing this affects new top-ups rather than payments already in flight.
# Review it when the market moves.
KODA_USD_PER_GBP=1.27
