{
  "name": "construx-field",
  "version": "0.1.0",
  "private": true,
  "description": "CONSTRUX Field — native Android and iOS field execution client, built to CONSTRUX Site Field Android/iOS Developer Specification v1.0 and the Field Mobile Apps Build Specification.",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "build:ios": "eas build --platform ios --profile development",
    "build:android": "eas build --platform android --profile development",
    "build:release": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^11.2.6",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.28",
    "expo-build-properties": "~0.13.2",
    "expo-camera": "~16.0.13",
    "expo-dev-client": "~5.0.10",
    "expo-file-system": "~18.0.7",
    "expo-local-authentication": "~15.0.1",
    "expo-location": "~18.0.5",
    "expo-notifications": "~0.29.12",
    "expo-secure-store": "~14.0.1",
    "expo-speech-recognition": "^1.1.1",
    "expo-updates": "~0.26.13",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-mmkv": "^3.2.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.3",
    "typescript": "~5.7.2"
  },
  "engines": { "node": ">=20" }
}
