# The engine floor in package.json is a requirement, not a preference.
#
# `engines.node` said `>=22.23.4` and nothing enforced it, so npm installed
# happily on anything. That floor is not a style choice: 22.23.4 is the release
# carrying the fix for the October 2026 advisory, and `deploy/Dockerfile`
# documents at length why the image tracks the LTS *line* rather than a minor
# precisely so it cannot be capped below it.
#
# The gap showed up in an audit: the development container was running
# v22.22.0 — below the floor, below the advisory — and every command in the
# repository ran without a word. A floor that is only observed where somebody
# happens to be current is not a floor.
#
# With this, `npm ci` and `npm install` refuse on a runtime below it and say
# which version is needed. Nothing else changes: `npm test` and `npm run
# typecheck` do not consult engines, so an existing checkout keeps working and
# it is the next install that tells the truth.
engine-strict=true

# Lock files are not advisory either. `npm ci` already refuses to update one;
# this makes `npm install` write exact versions rather than ranges, so what a
# second machine resolves is what the first one did.
save-exact=true
